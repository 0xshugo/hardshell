{
  "agents": [
    {
      "id": "mythos/orchestrator",
      "kill_switch": true,
      "tools": [
        {
          "id": "mcp:filesystem",
          "permissions": ["read"],
          "scope": "project workspace only",
          "approval_required": true,
          "rollback": true
        },
        {
          "id": "mcp:browserbase-readonly",
          "permissions": ["read"],
          "scope": "public web research only",
          "approval_required": false,
          "rollback": false
        }
      ]
    },
    {
      "id": "mythos/coder",
      "kill_switch": true,
      "tools": [
        {
          "id": "git-worktree",
          "permissions": ["read", "write"],
          "scope": "dedicated feature branch and reviewed files only",
          "approval_required": true,
          "audit_log": true,
          "rollback": true
        }
      ]
    }
  ],
  "mcp_servers": [
    {
      "id": "mcp:filesystem",
      "transport": "stdio",
      "network_access": false,
      "permissions": ["read"],
      "audit_log": true
    },
    {
      "id": "mcp:secfeed",
      "transport": "http",
      "network_access": true,
      "domain_allowlist": ["mcp.aoifuture.com"],
      "permissions": ["read"],
      "audit_log": true
    }
  ],
  "secrets": [
    {
      "id": "secfeed-bearer-token",
      "storage": "managed_secret",
      "scoped_to_agent": true,
      "rotation_days": 90,
      "least_privilege": true
    },
    {
      "id": "github-token",
      "storage": "keychain",
      "scoped_to_agent": true,
      "rotation_days": 90,
      "least_privilege": true
    }
  ]
}
