# hardshell configuration
# Copy to hardshell.toml, ~/.config/hardshell/config.toml, or /etc/hardshell/config.toml

[scan]
# Scanners to run by default (system is always available)
scanners = ["system", "trivy", "grype"]

# Enrich findings with CTI data (EPSS, CISA KEV)
enrich = true

# Run LLM analysis (requires 'claude' CLI in PATH)
analyze = false

# Default output format: terminal, json, markdown
format = "terminal"

# Trivy scan target (rootfs path or container image)
trivy_target = "/"

# Nuclei scan targets (URLs)
nuclei_targets = []

# Docker socket path
docker_socket = "/var/run/docker.sock"

# Optional AI-agent registry manifests for read-only posture checks.
# Example: hardshell scan --scanner agent-registry --config hardshell.toml
agent_registry_paths = ["./examples/mythos-agent-registry.json"]

# AI-agent posture scanners can be run together:
# hardshell scan --scanner agent-registry,tool-mcp,secret-config --format json --output build/hardshell-agent-posture.json
